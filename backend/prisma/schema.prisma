generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  branding           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  nodes              Node[]
  squads             Squad[]
  configProfiles     ConfigProfile[]
  subscriptionTemplates SubscriptionTemplate[]
  rules              Rule[]
  apiTokens          ApiToken[]
  notificationRoutes NotificationRoute[]
  routingProfiles    RoutingProfile[]
  dnsProfiles        DnsProfile[]
  balancers          Balancer[]
  reverseTunnels     ReverseTunnel[]
  vpnApps            VpnApp[]
  chains             ProxyChain[]
}

model User {
  id                     String                @id @default(uuid())
  email                  String                @unique
  passwordHash           String
  role                   Role                  @default(USER)
  status                 UserStatus            @default(ACTIVE)
  trafficLimit           BigInt                @default(0)
  trafficUsed            BigInt                @default(0)
  deviceLimit            Int                   @default(0)
  devices                Device[]
  externalLinks          UserExternalLink[]
  expiresAt              DateTime?
  subscriptionToken      String                @unique @default(uuid())
  telegramId             String?               @unique @map("telegram_id")
  configProfileId        String?
  configProfile          ConfigProfile?        @relation(fields: [configProfileId], references: [id], onDelete: SetNull)
  subscriptionTemplateId String?
  subscriptionTemplate   SubscriptionTemplate? @relation(fields: [subscriptionTemplateId], references: [id], onDelete: SetNull)
  squadId                String?
  squad                  Squad?                @relation(fields: [squadId], references: [id], onDelete: SetNull)
  organizationId         String?
  organization           Organization?         @relation(fields: [organizationId], references: [id])
  inbounds               Inbound[]
  inboundClients         InboundClient[]
  auditLogs              AuditLog[]
  payments               Payment[]
  trafficReports         UserTraffic[]
  refreshTokens          RefreshToken[]
  apiTokens              ApiToken[]
  chainBindings          ChainBinding[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([organizationId])
  @@index([organizationId, createdAt, id])
  @@index([squadId])
  @@index([status])
  @@index([createdAt, id])
}

enum Role {
  ADMIN
  OPERATOR
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Node {
  id                   String           @id @default(uuid())
  name                 String
  address              String
  port                 Int              @default(443)
  agentUrl             String?
  tokenHash            String
  agentSecret          String?
  jumpNodeId           String?
  ipv6Addresses        Json?
  ipv6Enabled          Boolean       @default(false)
  ipv6Address          String?
  ipv6VerifiedAt       DateTime?
  ipv6LastError        String?
  status               NodeStatus       @default(OFFLINE)
  lastSeenAt           DateTime?
  lastError            String?
  xrayVersion          String?
  agentVersion         String?
  agentUpdatedAt       DateTime?
  location             String?
  certificateHost      String?
  certificateIssuedAt  DateTime?
  certificateExpiresAt DateTime?
  metrics              NodeMetric[]
  healthChecks         HealthCheck[]
  geo                  NodeGeo?
  inbounds             Inbound[]
  revisions            ConfigRevision[]
  organizationId       String?
  organization         Organization?    @relation(fields: [organizationId], references: [id])
  configProfiles       ConfigProfile[]
  cheburchecks         CheburcheckResult[]
  reverseTunnels       ReverseTunnel[]
  chainHops            ProxyChainHop[] @relation("ChainHopNode")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([name])
}

enum NodeStatus {
  ONLINE
  OFFLINE
  ERROR
}

model NodeMetric {
  id          String   @id @default(uuid())
  nodeId      String
  node        Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  cpu         Float
  ram         Float
  disk        Float
  trafficUp   BigInt   @default(0)
  trafficDown BigInt   @default(0)
  connections Int      @default(0)
  xrayStatus  String?
  createdAt   DateTime @default(now())

  @@index([nodeId, createdAt])
}

model Inbound {
  id            String    @id @default(uuid())
  tag           String    @unique
  nodeId        String?
  node          Node?     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  protocol      String
  transport     String    @default("tcp")
  security      String    @default("none")
  port          Int
  listen        String    @default("0.0.0.0")
  flow          String?
  path          String?
  sni           String?
  serviceName   String?
  trafficLimit  BigInt    @default(0)
  trafficUsed   BigInt    @default(0)
  expiresAt     DateTime?
  resetSchedule String    @default("never")
  resetDay      Int?
  settings      Json
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  fallbacks  InboundFallback[] @relation("InboundFallbacks")
  fallbackOf InboundFallback[] @relation("FallbackChildren")
  clients    InboundClient[]
  squadLinks InboundSquad[]
  reverseTunnels ReverseTunnel[]
  rules      Rule[]
  routingProfiles RoutingProfile[]

  @@index([nodeId])
  @@index([userId])
}

model InboundFallback {
  id        String   @id @default(uuid())
  masterId  String
  master    Inbound  @relation("InboundFallbacks", fields: [masterId], references: [id], onDelete: Cascade)
  childId   String
  child     Inbound  @relation("FallbackChildren", fields: [childId], references: [id], onDelete: Cascade)
  path      String?
  alpn      String?
  dest      String?
  xver      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([masterId])
}

model InboundClient {
  id           String    @id @default(uuid())
  inboundId    String
  inbound      Inbound   @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trafficLimit BigInt    @default(0)
  expiresAt    DateTime?
  enabled      Boolean   @default(true)
  comment      String?
  sortIndex    Int       @default(0)
  sourceSquadId String?
  createdAt    DateTime  @default(now())

  @@unique([inboundId, userId])
  @@index([sourceSquadId])
  @@index([inboundId])
}

model Host {
  id        String   @id @default(uuid())
  address   String
  port      Int
  sni       String?
  path      String?
  recipe    String?
  note      String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Rule {
  id             String        @id @default(uuid())
  name           String
  type           String
  payload        Json
  recipe         String?
  note           String?
  enabled        Boolean       @default(true)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inboundId      String?
  inbound        Inbound?      @relation(fields: [inboundId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([inboundId])
}

model ConfigRevision {
  id        String   @id @default(uuid())
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  version   Int
  content   String
  applied   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([nodeId, version])
}

model TelemetrySetting {
  id                String    @id @default("default")
  installId         String    @unique
  accepted          Boolean   @default(false)
  declined          Boolean   @default(false)
  enabled           Boolean   @default(false)
  licenseAcceptedAt DateTime?
  lastSentAt        DateTime?
  updatedAt         DateTime  @updatedAt
}

model TelemetryInstallation {
  id        String               @id @default(uuid())
  installId String               @unique
  mode      String               @default("tenant")
  version   String?
  firstSeen DateTime             @default(now())
  lastSeen  DateTime             @default(now())
  snapshots TelemetrySnapshot[]
  logs      TelemetryLog[]
}

model TelemetrySnapshot {
  id             String               @id @default(uuid())
  installationId String
  installation   TelemetryInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  payload        Json
  createdAt      DateTime             @default(now())

  @@index([installationId, createdAt])
}

model TelemetryLog {
  id             String               @id @default(uuid())
  installationId String
  installation   TelemetryInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  level          String
  source         String
  message        String
  createdAt      DateTime             @default(now())

  @@index([installationId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model Payment {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  planId     String?
  plan       SubscriptionPlan? @relation(fields: [planId], references: [id])
  amount     Decimal           @db.Decimal(10, 2)
  currency   String            @default("USD")
  status     String
  provider   String
  externalId String?
  createdAt  DateTime          @default(now())

  @@index([userId])
  @@index([planId])
}

model SubscriptionPlan {
  id           String    @id @default(uuid())
  name         String
  price        Decimal   @db.Decimal(10, 2)
  trafficGb    Int
  durationDays Int
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  payments     Payment[]
}

model UserTraffic {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId    String?
  period    String
  bytesUp   BigInt   @default(0)
  bytesDown BigInt   @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([period])
}

model SubscriptionTemplate {
  id             String        @id @default(uuid())
  name           String
  title          String
  description    String?
  accent         String        @default("#8474ff")
  instructions   Json?
  footer         String?
  pageSettings   Json?
  enabled        Boolean       @default(true)
  isDefault      Boolean       @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  users          User[]
  squads         Squad[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([enabled])
  @@index([organizationId])
}

// Глобальные настройки публичной страницы подписки ( singleton id="default" ).
model SubscriptionPageSettings {
  id        String   @id @default("default")
  settings  Json
  updatedAt DateTime @updatedAt
}

// Приложения для публичной страницы подписки, редактируются из панели.
model VpnApp {
  id               String        @id @default(uuid())
  name             String
  platform         String
  iconUrl          String?
  downloadUrl      String?
  deepLinkTemplate String?
  instructions     Json?
  sortOrder        Int           @default(0)
  enabled          Boolean       @default(true)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([enabled, sortOrder])
}

model NodeGeo {
  id          String   @id @default(uuid())
  nodeId      String   @unique
  node        Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  ip          String?
  countryCode String?
  city        String?
  asn         String?
  org         String?
  checkedAt   DateTime @default(now())

  @@index([checkedAt])
}

model HealthCheck {
  id        String   @id @default(uuid())
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  inboundId String?
  tag       String
  protocol  String
  host      String
  port      Int
  success   Boolean
  latencyMs Int?
  error     String?
  checkedAt DateTime @default(now())

  @@index([nodeId, checkedAt])
  @@index([checkedAt])
}

model Device {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hwid       String    @unique
  name       String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Squad {
  id             String        @id @default(uuid())
  name           String
  description    String?
  trafficLimit   BigInt        @default(0)
  expiresAt      DateTime?
  enabled        Boolean       @default(true)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subscriptionTemplateId String?
  subscriptionTemplate   SubscriptionTemplate? @relation(fields: [subscriptionTemplateId], references: [id], onDelete: SetNull)
  users          User[]
  chainBindings  ChainBinding[]
  inboundLinks   InboundSquad[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([enabled])
  @@index([organizationId])
}

model ConfigProfile {
  id             String        @id @default(uuid())
  name           String
  description    String?
  payload        Json
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  users          User[]
  nodeId         String?
  node           Node?         @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@index([nodeId])
  @@index([organizationId])
}

model RoutingProfile {
  id             String        @id @default(uuid())
  name           String
  description    String?
  payload        Json
  recipe         String?
  enabled        Boolean       @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inboundId      String?
  inbound        Inbound?      @relation(fields: [inboundId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

model BackupSettings {
  id            String    @id @default("default")
  enabled       Boolean   @default(false)
  intervalHours Int       @default(24)
  retention     Int       @default(7)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model GeodataCategory {
  id          String   @id @default(uuid())
  type        String
  code        String
  name        String
  description String?
  source      String   @default("bundled")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, code])
  @@index([type, enabled])
}

model AlertHistory {
  id        String   @id @default(uuid())
  status    String
  title     String
  message   String?
  severity  String?
  source    String   @default("grafana")
  labels    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

enum ApiTokenScope {
  MONITOR
  NODE_SYNC
  NOTIFICATIONS
  USERS_READ
  NODE_DOMAIN
  PLUGIN_STORE
  TELEMETRY
}

model NodeDomain {
  id          String    @id @default(uuid())
  label       String    @unique
  fqdn        String    @unique
  tenantOrgId String?
  nodeId      String?
  address     String?
  ipv6        String?
  location    String?
  zone        String    @default("node.h2onetwork.pro")
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantOrgId, releasedAt])
}

// SSH-креды мастера: только шифртекст AES-256-GCM, ключ — PANEL_MASTER_KEY.
model WizardCredential {
  id         String   @id @default(uuid())
  nodeId     String   @unique
  authMode   String
  sshHost    String?
  sshUser    String?
  sshPort    Int?
  location   String?
  nodeName   String?
  ipv4       String?
  ipv6       String?
  password   String?
  privateKey String?
  passphrase String?
  userDomain String?
  createdAt  DateTime @default(now())
}

model NodeInstallJob {
  installId      String            @id
  status         String            @default("running")
  stage          String            @default("start")
  progress       Int               @default(0)
  nodeId         String?
  error          String?
  userId         String?
  organizationId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  logs           NodeInstallLog[]

  @@index([userId, createdAt])
}

model NodeInstallLog {
  id        String         @id @default(uuid())
  installId String
  job       NodeInstallJob @relation(fields: [installId], references: [installId], onDelete: Cascade)
  level     String         @default("info")
  stage     String
  message   String
  createdAt DateTime       @default(now())

  @@index([installId, createdAt])
}

model ApiToken {
  id             String          @id @default(uuid())
  name           String
  tokenHash      String          @unique
  scopes         ApiTokenScope[]
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime        @default(now())

  @@index([userId, revokedAt])
  @@index([organizationId])
}

enum NotificationEvent {
  NODE_OFFLINE
  NODE_ONLINE
  TRAFFIC_ALERT
  USER_EXPIRED
  BACKUP_FAILED
  CONFIG_APPLIED
  PAYMENT_RECEIVED
  CHEBURCHECK_BLOCKED
}

enum NotificationChannel {
  TELEGRAM
  WEBHOOK
  EMAIL
  SIGNAL
}

model NotificationRoute {
  id             String              @id @default(uuid())
  event          NotificationEvent
  channel        NotificationChannel
  enabled        Boolean             @default(true)
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([event, channel, organizationId])
  @@index([organizationId, enabled])
}

// Реквизиты каналов: только шифртекст (PANEL_MASTER_KEY). Значения не возвращаются API.
model NotificationCredential {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model NotificationPolicy {
  id                 String   @id @default("default")
  enabled            Boolean  @default(true)
  quietHoursStart    String?
  quietHoursEnd      String?
  cooldownMinutes    Int      @default(0)
  minSeverity        String   @default("warning")
  escalationChannel  String?
  updatedAt          DateTime @updatedAt
}

// CONTROL-режим: настройки PowerDNS, редактируемые в UI. Секреты шифруются.
model DnsProfile {
  id             String        @id @default(uuid())
  name           String
  description    String?
  enabled        Boolean       @default(false)
  priority       Int           @default(0)
  hosts          Json?
  servers        Json
  options        Json?
  recipe         String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, enabled])
}

// VLESS reverse: нода за NAT пробивает туннель к публичной ноде-порталу.
model ReverseTunnel {
  id             String        @id @default(uuid())
  name           String
  enabled        Boolean       @default(false)
  nodeId         String
  node           Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  portalInboundId String
  portalInbound  Inbound       @relation(fields: [portalInboundId], references: [id], onDelete: Cascade)
  publicPort     Int
  internalAddress String       @default("127.0.0.1")
  internalPort   Int
  bridgeUuid     String        @default(uuid())
  reverseDomain  String        @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([nodeId, enabled])
}

enum PluginStatus {
  INSTALLED
  ENABLED
  DISABLED
  QUARANTINED
  FAILED
}

model Plugin {
  id            String       @id @default(uuid())
  pluginId      String       @unique
  version       String
  manifest      Json
  status        PluginStatus @default(INSTALLED)
  settings      Json?
  permissions   Json?
  artifactPath  String?
  signature     Json?
  lastError     String?
  lastHealthAt  DateTime?
  enabledAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model PluginRecipe {
  id        String   @id
  pluginId  String
  recipeId  String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pluginId, recipeId])
  @@index([pluginId])
}

model PluginStorage {
  pluginId  String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([pluginId, key])
}

model PluginLog {
  id        String   @id @default(uuid())
  pluginId  String
  level     String
  message   String
  createdAt DateTime @default(now())

  @@index([pluginId, createdAt])
}

model PluginCatalogCache {
  id        String   @id @default("default")
  etag      String?
  body      Json
  fetchedAt DateTime
  offline   Boolean  @default(false)
}

model PluginPolicy {
  id            String   @id @default("default")
  whitelist     Json?
  blacklist     Json?
  mandatory     Json?
  forcedUpdates Json?
  updatedAt     DateTime @updatedAt
}

enum StorePluginStatus {
  DRAFT
  REVIEW
  PUBLISHED
  SUSPENDED
}

model StorePlugin {
  id          String            @id @default(uuid())
  slug        String            @unique
  name        String
  author      String
  description String
  category    String            @default("utility")
  iconUrl     String?
  screenshots Json?
  rating      Float             @default(0)
  status      StorePluginStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    StoreVersion[]
}

model StoreVersion {
  id          String      @id @default(uuid())
  pluginId    String
  plugin      StorePlugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  version     String
  manifest    Json
  payload     Json
  sha256      String
  signature   Json?
  changelog   String?
  compatibility Json?
  createdAt   DateTime    @default(now())

  @@unique([pluginId, version])
}

model StoreRevocation {
  id        String   @id @default(uuid())
  pluginId  String
  version   String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([pluginId])
}

model Balancer {
  id               String           @id @default(uuid())
  name             String
  strategy         String           @default("roundRobin")
  enabled          Boolean          @default(false)
  fallbackTag      String           @default("direct")
  probeUrl         String           @default("https://www.google.com/generate_204")
  probeIntervalSec Int              @default(30)
  observatoryMode  String           @default("observatory")
  burstDestination String           @default("https://connectivitycheck.gstatic.com/generate_204")
  burstIntervalSec Int              @default(60)
  burstSampling    Int              @default(10)
  burstTimeoutSec  Int              @default(5)
  rule             Json?
  organizationId   String?
  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members          BalancerMember[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organizationId, enabled])
}

model BalancerMember {
  id         String   @id @default(uuid())
  balancerId String
  balancer   Balancer @relation(fields: [balancerId], references: [id], onDelete: Cascade)
  protocol   String
  // Зашифрованный JSON настроек outbound (PANEL_MASTER_KEY).
  config     String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([balancerId, enabled])
}

model DnsSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CheburcheckResult {
  id         String   @id @default(uuid())
  nodeId     String?
  node       Node?    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  target     String
  targetType String?
  blocked    Boolean  @default(false)
  verdict    String?
  payload    Json
  createdAt  DateTime @default(now())

  @@index([nodeId, createdAt])
  @@index([createdAt])
}

model NotificationDelivery {
  id         String   @id @default(uuid())
  event      String
  channel    String
  status     String
  dedupeKey  String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([dedupeKey, createdAt])
  @@index([createdAt])
}

enum SnapshotKind {
  MANUAL
  PRE_UPDATE
  PRE_SETTINGS_CHANGE
  SCHEDULED
  PRE_RESTORE
}

enum SnapshotScope {
  FULL
  SETTINGS
}

enum SnapshotStatus {
  CREATING
  READY
  FAILED
  RESTORING
  RESTORED
}

model SystemSnapshot {
  id           String         @id @default(uuid())
  label        String
  kind         SnapshotKind   @default(MANUAL)
  scope        SnapshotScope  @default(FULL)
  status       SnapshotStatus @default(CREATING)
  reason       String?
  directory    String
  checksum     String
  sizeBytes    Int            @default(0)
  appVersion   String
  actorId      String?
  error        String?
  restoreError String?
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?
  restoredAt   DateTime?

  @@index([kind, createdAt])
  @@index([status, createdAt])
}

model SnapshotPolicy {
  id                 String   @id @default("default")
  autoBeforeUpdates  Boolean  @default(true)
  autoBeforeSettings Boolean  @default(true)
  retention          Int      @default(10)
  cooldownMinutes    Int      @default(15)
  updatedAt          DateTime @updatedAt
}


model ProxyChain {
  id             String          @id @default(uuid())
  name           String
  status         String          @default("active")
  routingMode    String          @default("all")
  bridgeMode     String          @default("auto")
  routingRules   Json?
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  hops           ProxyChainHop[]
  bindings       ChainBinding[]

  @@index([organizationId])
}

model ProxyChainHop {
  id         String      @id @default(uuid())
  chainId    String
  chain      ProxyChain  @relation(fields: [chainId], references: [id], onDelete: Cascade)
  nodeId     String
  node       Node        @relation("ChainHopNode", fields: [nodeId], references: [id], onDelete: Cascade)
  role       String
  priority   Int         @default(0)
  protocol   String      @default("vless")
  security   String      @default("reality")
  port       Int
  listen     String      @default("0.0.0.0")
  uuid       String
  privateKey String?
  publicKey  String?
  shortId    String?
  sni        String?
  enabled    Boolean     @default(true)
  createdAt  DateTime    @default(now())

  @@unique([chainId, nodeId, role])
  @@index([nodeId])
}

model ChainBinding {
  id        String      @id @default(uuid())
  chainId   String
  chain     ProxyChain  @relation(fields: [chainId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  squadId   String?
  squad     Squad?      @relation(fields: [squadId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([squadId])
}

model InboundSquad {
  id        String   @id @default(uuid())
  inboundId String
  squadId   String
  createdAt DateTime @default(now())
  inbound   Inbound  @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  squad     Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@unique([inboundId, squadId])
  @@index([squadId])
}

model UserExternalLink {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String      @default("link")
  value          String
  remark         String?
  enabled        Boolean     @default(true)
  sortIndex      Int         @default(0)
  lastFetchAt    DateTime?
  lastFetchError String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
}

