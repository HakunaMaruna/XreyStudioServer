generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  branding           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  nodes              Node[]
  squads             Squad[]
  configProfiles     ConfigProfile[]
  subscriptionTemplates SubscriptionTemplate[]
  rules              Rule[]
  apiTokens          ApiToken[]
  notificationRoutes NotificationRoute[]
  routingProfiles    RoutingProfile[]
}

model User {
  id                     String                @id @default(uuid())
  email                  String                @unique
  passwordHash           String
  role                   Role                  @default(USER)
  status                 UserStatus            @default(ACTIVE)
  trafficLimit           BigInt                @default(0)
  trafficUsed            BigInt                @default(0)
  deviceLimit            Int                   @default(0)
  devices                Device[]
  expiresAt              DateTime?
  subscriptionToken      String                @unique @default(uuid())
  configProfileId        String?
  configProfile          ConfigProfile?        @relation(fields: [configProfileId], references: [id], onDelete: SetNull)
  subscriptionTemplateId String?
  subscriptionTemplate   SubscriptionTemplate? @relation(fields: [subscriptionTemplateId], references: [id], onDelete: SetNull)
  squadId                String?
  squad                  Squad?                @relation(fields: [squadId], references: [id], onDelete: SetNull)
  organizationId         String?
  organization           Organization?         @relation(fields: [organizationId], references: [id])
  inbounds               Inbound[]
  inboundClients         InboundClient[]
  auditLogs              AuditLog[]
  payments               Payment[]
  trafficReports         UserTraffic[]
  refreshTokens          RefreshToken[]
  apiTokens              ApiToken[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([organizationId])
  @@index([organizationId, createdAt, id])
  @@index([squadId])
  @@index([status])
  @@index([createdAt, id])
}

enum Role {
  ADMIN
  OPERATOR
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Node {
  id                   String           @id @default(uuid())
  name                 String
  address              String
  port                 Int              @default(443)
  agentUrl             String?
  tokenHash            String
  status               NodeStatus       @default(OFFLINE)
  lastSeenAt           DateTime?
  lastError            String?
  xrayVersion          String?
  location             String?
  certificateHost      String?
  certificateIssuedAt  DateTime?
  certificateExpiresAt DateTime?
  metrics              NodeMetric[]
  healthChecks         HealthCheck[]
  geo                  NodeGeo?
  inbounds             Inbound[]
  revisions            ConfigRevision[]
  organizationId       String?
  organization         Organization?    @relation(fields: [organizationId], references: [id])
  configProfiles       ConfigProfile[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([name])
}

enum NodeStatus {
  ONLINE
  OFFLINE
  ERROR
}

model NodeMetric {
  id          String   @id @default(uuid())
  nodeId      String
  node        Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  cpu         Float
  ram         Float
  disk        Float
  trafficUp   BigInt   @default(0)
  trafficDown BigInt   @default(0)
  connections Int      @default(0)
  xrayStatus  String?
  createdAt   DateTime @default(now())

  @@index([nodeId, createdAt])
}

model Inbound {
  id            String    @id @default(uuid())
  tag           String    @unique
  nodeId        String?
  node          Node?     @relation(fields: [nodeId], references: [id])
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  protocol      String
  transport     String    @default("tcp")
  security      String    @default("none")
  port          Int
  listen        String    @default("0.0.0.0")
  flow          String?
  path          String?
  sni           String?
  serviceName   String?
  trafficLimit  BigInt    @default(0)
  trafficUsed   BigInt    @default(0)
  expiresAt     DateTime?
  resetSchedule String    @default("never")
  resetDay      Int?
  settings      Json
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  fallbacks  InboundFallback[] @relation("InboundFallbacks")
  fallbackOf InboundFallback[] @relation("FallbackChildren")
  clients    InboundClient[]

  @@index([nodeId])
  @@index([userId])
}

model InboundFallback {
  id        String   @id @default(uuid())
  masterId  String
  master    Inbound  @relation("InboundFallbacks", fields: [masterId], references: [id], onDelete: Cascade)
  childId   String
  child     Inbound  @relation("FallbackChildren", fields: [childId], references: [id], onDelete: Cascade)
  path      String?
  alpn      String?
  dest      String?
  xver      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([masterId])
}

model InboundClient {
  id           String    @id @default(uuid())
  inboundId    String
  inbound      Inbound   @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trafficLimit BigInt    @default(0)
  expiresAt    DateTime?
  enabled      Boolean   @default(true)
  comment      String?
  sortIndex    Int       @default(0)
  createdAt    DateTime  @default(now())

  @@unique([inboundId, userId])
  @@index([inboundId])
}

model Host {
  id        String   @id @default(uuid())
  address   String
  port      Int
  sni       String?
  path      String?
  recipe    String?
  note      String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Rule {
  id             String        @id @default(uuid())
  name           String
  type           String
  payload        Json
  recipe         String?
  note           String?
  enabled        Boolean       @default(true)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([organizationId])
}

model ConfigRevision {
  id        String   @id @default(uuid())
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  version   Int
  content   String
  applied   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([nodeId, version])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model Payment {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  planId     String?
  plan       SubscriptionPlan? @relation(fields: [planId], references: [id])
  amount     Decimal           @db.Decimal(10, 2)
  currency   String            @default("USD")
  status     String
  provider   String
  externalId String?
  createdAt  DateTime          @default(now())

  @@index([userId])
  @@index([planId])
}

model SubscriptionPlan {
  id           String    @id @default(uuid())
  name         String
  price        Decimal   @db.Decimal(10, 2)
  trafficGb    Int
  durationDays Int
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  payments     Payment[]
}

model UserTraffic {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId    String?
  period    String
  bytesUp   BigInt   @default(0)
  bytesDown BigInt   @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([period])
}

model SubscriptionTemplate {
  id             String        @id @default(uuid())
  name           String
  title          String
  description    String?
  accent         String        @default("#8474ff")
  instructions   Json?
  footer         String?
  enabled        Boolean       @default(true)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  users          User[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([enabled])
  @@index([organizationId])
}

model NodeGeo {
  id          String   @id @default(uuid())
  nodeId      String   @unique
  node        Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  ip          String?
  countryCode String?
  city        String?
  asn         String?
  org         String?
  checkedAt   DateTime @default(now())

  @@index([checkedAt])
}

model HealthCheck {
  id        String   @id @default(uuid())
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  inboundId String?
  tag       String
  protocol  String
  host      String
  port      Int
  success   Boolean
  latencyMs Int?
  error     String?
  checkedAt DateTime @default(now())

  @@index([nodeId, checkedAt])
  @@index([checkedAt])
}

model Device {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hwid       String    @unique
  name       String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Squad {
  id             String        @id @default(uuid())
  name           String
  description    String?
  trafficLimit   BigInt        @default(0)
  expiresAt      DateTime?
  enabled        Boolean       @default(true)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  users          User[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([enabled])
  @@index([organizationId])
}

model ConfigProfile {
  id             String        @id @default(uuid())
  name           String
  description    String?
  payload        Json
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  users          User[]
  nodeId         String?
  node           Node?         @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@index([nodeId])
  @@index([organizationId])
}

model RoutingProfile {
  id             String        @id @default(uuid())
  name           String
  description    String?
  payload        Json
  recipe         String?
  enabled        Boolean       @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

model BackupSettings {
  id            String    @id @default("default")
  enabled       Boolean   @default(false)
  intervalHours Int       @default(24)
  retention     Int       @default(7)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model GeodataCategory {
  id          String   @id @default(uuid())
  type        String
  code        String
  name        String
  description String?
  source      String   @default("bundled")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, code])
  @@index([type, enabled])
}

model AlertHistory {
  id        String   @id @default(uuid())
  status    String
  title     String
  message   String?
  severity  String?
  source    String   @default("grafana")
  labels    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

enum ApiTokenScope {
  MONITOR
  NODE_SYNC
  NOTIFICATIONS
  USERS_READ
  NODE_DOMAIN
}

model NodeDomain {
  id          String    @id @default(uuid())
  label       String    @unique
  fqdn        String    @unique
  tenantOrgId String?
  nodeId      String?
  address     String?
  ipv6        String?
  location    String?
  zone        String    @default("node.h2onetwork.pro")
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantOrgId, releasedAt])
}

// SSH-креды мастера: только шифртекст AES-256-GCM, ключ — PANEL_MASTER_KEY.
model WizardCredential {
  id         String   @id @default(uuid())
  nodeId     String   @unique
  authMode   String
  sshHost    String?
  sshUser    String?
  sshPort    Int?
  location   String?
  nodeName   String?
  ipv4       String?
  ipv6       String?
  password   String?
  privateKey String?
  passphrase String?
  userDomain String?
  createdAt  DateTime @default(now())
}

model ApiToken {
  id             String          @id @default(uuid())
  name           String
  tokenHash      String          @unique
  scopes         ApiTokenScope[]
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime        @default(now())

  @@index([userId, revokedAt])
  @@index([organizationId])
}

enum NotificationEvent {
  NODE_OFFLINE
  NODE_ONLINE
  TRAFFIC_ALERT
  USER_EXPIRED
  BACKUP_FAILED
  CONFIG_APPLIED
  PAYMENT_RECEIVED
}

enum NotificationChannel {
  TELEGRAM
  WEBHOOK
  EMAIL
  SIGNAL
}

model NotificationRoute {
  id             String              @id @default(uuid())
  event          NotificationEvent
  channel        NotificationChannel
  enabled        Boolean             @default(true)
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([event, channel, organizationId])
  @@index([organizationId, enabled])
}

// Реквизиты каналов: только шифртекст (PANEL_MASTER_KEY). Значения не возвращаются API.
model NotificationCredential {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model NotificationPolicy {
  id                 String   @id @default("default")
  enabled            Boolean  @default(true)
  quietHoursStart    String?
  quietHoursEnd      String?
  cooldownMinutes    Int      @default(0)
  minSeverity        String   @default("warning")
  escalationChannel  String?
  updatedAt          DateTime @updatedAt
}

model NotificationDelivery {
  id         String   @id @default(uuid())
  event      String
  channel    String
  status     String
  dedupeKey  String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([dedupeKey, createdAt])
  @@index([createdAt])
}
