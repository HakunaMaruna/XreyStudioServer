NODE_ENV=production
DOMAIN=example.com
PANEL_URL=https://example.com
# Public origin for canonical links, Open Graph, robots.txt and sitemap.xml.
# Set this to the externally visible panel URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://example.com
# Consider a node offline when its agent heartbeat is older than this (ms, default 120000)
NODE_OFFLINE_AFTER_MS=120000
# Default wizard inbound: VLESS + Reality + xtls-rprx-vision on port 443.
# Reality destination must be the local TLS decoy on the node.
WIZARD_DECOY_HOST=127.0.0.1
WIZARD_DECOY_PORT=8443
# Explicit fallback to legacy VLESS TLS if a node domain is missing (logs a warning).
WIZARD_REALITY_FALLBACK=false
# Resolvers used to verify that the node domain points at the node IP before setup.
NODE_DNS_RESOLVERS=1.1.1.1,8.8.8.8
# Node-side TLS decoy and ACME HTTP-01 responder.
DECOY_PORT=8443
DECOY_HTTP_PORT=80
DECOY_TLS_DIR=/etc/xss-agent/decoy
ACME_WEBROOT=/var/www/certbot

# SSH provisioning from the UI (off by default). Secrets are never stored.
SSH_PROVISION_ENABLED=false
# Optional pinned git repository used on the remote host.
NODE_PROVISION_REPO=https://github.com/HakunaMaruna/XreyStudioServer.git
# Ed25519 public key (PEM) used to verify signed release bundles.
# Generate with: openssl genpkey -algorithm ed25519 -out update_private.pem
# Then: openssl pkey -in update_private.pem -pubout -out update_public.pem
UPDATE_PUBLIC_KEY=
# Проверка обновлений (GitHub Releases) и автообновление панели.
# Канал и включение проверки задаются в Настройках; здесь — источник и доступ.
# UPDATE_REPO=HakunaMaruna/XreyStudioServer
# GITHUB_TOKEN=
# Опциональный JSON-эндпоинт {version,url,notes,publishedAt} для закрытых сетей
# UPDATE_CHECK_URL=
# Updater-сайдкар (docker compose --profile updater up -d): токен обязателен,
# порт наружу не публикуется.
UPDATER_TOKEN=
UPDATER_URL=http://updater:7070
# Backups: AES-256-GCM client-side encryption key (base64, 32 bytes).
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
# Optional S3/R2 destination for encrypted backups.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=backups/
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Optional server-side encryption header (R2 may not support it).
BACKUP_S3_SSE=

POSTGRES_USER=xss
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=xss

JWT_SECRET=replace-with-a-random-32-char-secret-value
JWT_REFRESH_SECRET=change-me-refresh-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# argon2id (default) or bcrypt for new password hashes; existing hashes stay readable
PASSWORD_HASHER=argon2id
# Shared secret for Grafana -> backend alert webhook
ALERT_WEBHOOK_TOKEN=change-me-alert-token

# Long-lived token for the read-only MCP bridge at /api/mcp (see docs/mcp.md)
MCP_TOKEN=change-me-mcp-token
# Required to approve MCP write-plans. Min 16 characters; never expose to clients.
MCP_APPROVAL_TOKEN=

# Per-user traffic stats from the in-container Xray API (agent runs Xray itself)
XRAY_STATS_ENABLED=true
XRAY_API_PORT=8080

# Exit-IP geocheck for nodes (agent -> panel every 6h)
GEOCHECK_URL=https://ipinfo.io/json
GEOCHECK_INTERVAL=21600000

# CONTROL mode: PowerDNS authoritative for node.h2onetwork.pro
PANEL_MODE=tenant
PDNS_API_KEY=change-me-dns-api-key
PANEL_MASTER_KEY=base64-32-bytes-for-ssh-secrets
NODE_DNS_ZONE=node.h2onetwork.pro
NODE_DNS_TTL=60
# Публичный IP сервера: Let's Encrypt должен обращаться к authoritative DNS.
# 127.0.0.1 — только для smoke-теста; 0.0.0.0 может конфликтовать с systemd-resolved (127.0.0.53).
PDNS_BIND_IP=0.0.0.0

# Let's Encrypt for panel nodes (HTTP-01: point node-<id>.<suffix> to this panel's IP)
NODE_DOMAIN_SUFFIX=example.com
NODE_DOMAIN_TEMPLATE=node-{id}.{suffix}
LE_EMAIL=admin@example.com
ACME_WEBROOT=/var/www/certbot
CERTS_DIR=/app/certs

CORS_ORIGIN=https://example.com

# Agent keys below are copied into .agent.env by install.sh; the agent container
# never mounts the full .env (JWT/DB/Stripe/MCP secrets stay in the panel).
AGENT_TOKEN=replace-with-a-random-agent-token
AGENT_SECRET=
NODE_ID=node-1
NODE_ADDRESS=127.0.0.1

# Per-user traffic from the Xray Stats API (adds a loopback API inbound to generated configs)
XRAY_STATS_ENABLED=false
XRAY_API_HOST=127.0.0.1
XRAY_API_PORT=8080
TRAFFIC_REPORT_INTERVAL=60000
# Set to true only for local development with private/LAN agent URLs
ALLOW_PRIVATE_AGENT_URLS=false
# Wizard-provisioned nodes speak plain HTTP on :9090 without a node certificate.
# This relaxes only the https requirement; private/link-local hosts remain blocked.
ALLOW_HTTP_AGENT_URLS=false

# Optional log files used by the agent /logs endpoint when journalctl is unavailable
XRAY_LOG_PATH=
SINGBOX_LOG_PATH=

# Optional sing-box engine for Hysteria2 / TUIC / WireGuard inbounds
SINGBOX_CONFIG_PATH=/etc/sing-box/config.json
SINGBOX_BIN=sing-box
SINGBOX_SERVICE=sing-box

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Telegram bot webhook. TELEGRAM_WEBHOOK_SECRET is part of the webhook URL only;
# it is never sent in messages or stored in the database. Min 16 characters.
TELEGRAM_WEBHOOK_SECRET=

# Generic webhook (Slack/Discord/custom) receives JSON notifications
WEBHOOK_URL=
# Email notifications via SMTP; alerts are sent to ALERT_EMAIL_TO
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ALERT_EMAIL_TO=
# Signal via signal-cli-rest-api (https://github.com/bbernhard/signal-cli-rest-api)
SIGNAL_API_URL=
SIGNAL_PHONE_NUMBER=
SIGNAL_RECIPIENT=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

METRICS_TOKEN=
REDIS_URL=redis://redis:6379
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

GRAFANA_PASSWORD=change-me-grafana
BACKUP_DIR=backups
BACKUP_KEEP=7
# Rescue CLI password source (preferred over passing the password as an argv item).
RESCUE_NEW_PASSWORD=

# Optional hidden admin entry. When PANEL_DECOY=true the public address serves a
# benign page; the panel is reachable at /<PANEL_ENTRY_PATH>/login or after login.
# PANEL_ENTRY_PATH must be a secret single path segment (letters, digits, - and _).
PANEL_DECOY=false
PANEL_ENTRY_PATH=


# Plugin App Store (CONTROL mode)
STORE_DB=xss_store
STORE_ADMIN_TOKEN=change-me-store-admin-token
STORE_API_URL=http://store:3012
PLUGIN_STORE_PUBLIC_KEY=
PLUGIN_ALLOW_UNSIGNED=false
PLUGIN_AUTO_SNAPSHOT=true

# Telemetry (optional, voluntary, requires admin consent in the panel)
TELEMETRY_URL=
TELEMETRY_TOKEN=
TELEMETRY_INTERVAL_MS=21600000

# Remote SSH command timeout in wizard provisioning (ms, min 30000, default 600000)
NODE_PROVISION_COMMAND_TIMEOUT_MS=600000
